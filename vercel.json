{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/biosync-site/index.html" },
    { "source": "/styles.css", "destination": "/biosync-site/styles.css" },
    { "source": "/script.js", "destination": "/biosync-site/script.js" },
    { "source": "/public/(.*)", "destination": "/biosync-site/public/$1" },
    { "source": "/(.*)", "destination": "/biosync-site/$1" }
  ]
}
